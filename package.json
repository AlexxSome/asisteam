{
  "name": "asisteam",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "supabase": "supabase",
    "lint": "eslint . --max-warnings=0",
    "ci:checks": "node scripts/ci/checks.mjs",
    "api:generate": "pnpm --filter @asisteam/core build && pnpm --filter @asisteam/api-client generate",
    "api:check": "pnpm --filter @asisteam/core build && pnpm --filter @asisteam/api-client check:generated",
    "ci:backend": "node scripts/ci/backend.mjs",
    "ci:staging": "node scripts/ci/staging.mjs",
    "ci:extended": "node scripts/ci/extended.mjs",
    "migration:portability": "node scripts/migration/portability/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.4.0",
    "supabase": "^2.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.71.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase"
    ]
  }
}
