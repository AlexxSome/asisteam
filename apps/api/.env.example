NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Fixture local únicamente. Producción: inyectar URL del rol mínimo, TLS verificado.
DATABASE_URL=postgresql://asisteam_runtime:synthetic-only@127.0.0.1:5432/asisteam_test
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=2000
PG_STATEMENT_TIMEOUT_MS=3000
HTTP_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# El runtime productivo exige los cinco valores de identidad propia completos.
# Inyectar fuera del repositorio; PostgreSQL independiente con roles mínimos.
# NATIVE_AUTH_DATABASE_URL=
# NATIVE_AUTH_SECRET=
# NATIVE_AUTH_ISSUER=
# NATIVE_AUTH_WEB_URL=
# NATIVE_AUTH_PROXY_SECRET=
# SUPABASE_AUTH_URL/PUBLIC_KEY y puente de invitaciones están retirados.
