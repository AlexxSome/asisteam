{
  "name": "@asisteam/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:api-contract": "node scripts/api-contract-smoke.mjs",
    "test:integration": "node e2e/run-integrations.mjs",
    "test:integration:modules": "node e2e/run-integrations.mjs",
    "test:invitations": "node e2e/run-integrations.mjs src/app/invitations/[token]/invitation.integration.test.ts",
    "test:send-invitations": "node e2e/run-integrations.mjs send-invitation.integration.test.ts",
    "test:e2e": "playwright test --grep-invert @extended",
    "test:e2e:full": "playwright test",
    "test:e2e:faults": "playwright test -c playwright.fault.config.ts",
    "test:e2e:report": "playwright show-report .qa/report",
    "test:auth-contract": "node scripts/native-auth-smoke.mjs",
    "test:social-contract": "node scripts/social-auth-smoke.mjs"
  },
  "dependencies": {
    "@asisteam/api-client": "workspace:*",
    "@asisteam/core": "workspace:*",
    "@asisteam/db": "workspace:*",
    "@hookform/resolvers": "^3.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.0.0",
    "qrcode.react": "4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
