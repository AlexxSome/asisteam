{
  "name": "@asisteam/web-vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs && node scripts/artifact.mjs",
    "start": "node scripts/static-server.mjs",
    "test:infrastructure": "node --test scripts/static-server.test.mjs",
    "test:bundle": "node scripts/check-performance.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report .qa/report"
  },
  "dependencies": {
    "@asisteam/api-client": "workspace:*",
    "@asisteam/core": "workspace:*",
    "clsx": "^2.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.4",
    "qrcode.react": "4.2.0",
    "tailwind-merge": "^3.0.0",
    "react-hook-form": "^7.54.0",
    "@hookform/resolvers": "^3.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.19.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "^3.2.7"
  }
}
