{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@asisteam/worker#test": {
      "dependsOn": [
        "build",
        "^test"
      ]
    },
    "@asisteam/worker#typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ]
    },
    "@asisteam/api#test": {
      "dependsOn": [
        "build",
        "^test"
      ]
    },
    "@asisteam/api#typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ]
    },
    "@asisteam/api-client#test": {
      "dependsOn": [
        "build",
        "^test"
      ]
    },
    "@asisteam/api-client#typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ]
    },
    "@asisteam/web#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": false,
      "env": [
        "SOURCE_COMMIT"
      ]
    },
    "@asisteam/web#typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ]
    },
    "@asisteam/web#test": {
      "dependsOn": [
        "^build",
        "^test"
      ]
    }
  }
}
