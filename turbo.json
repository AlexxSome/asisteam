{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^test"] },
    "dev": { "cache": false, "persistent": true },
    "@asisteam/api#test": { "dependsOn": ["build", "^test"] },
    "@asisteam/api#typecheck": { "dependsOn": ["^build", "^typecheck"] },
    "@asisteam/api-client#test": { "dependsOn": ["build", "^test"] },
    "@asisteam/api-client#typecheck": { "dependsOn": ["^build", "^typecheck"] },
    "@asisteam/web#typecheck": { "dependsOn": ["^build", "^typecheck"] },
    "@asisteam/web#test": { "dependsOn": ["^build", "^test"] }
  }
}
