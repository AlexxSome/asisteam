  "dependencies": { "@asisteam/core": "workspace:*", "zod": "^3.25.0" },
  "devDependencies": { "@types/node": "24.19.1", "typescript": "5.9.3", "openapi-typescript": "7.13.0", "zod-to-json-schema": "3.25.2" }
